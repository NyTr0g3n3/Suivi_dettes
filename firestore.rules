rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper function to validate incoming data has required fields
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Contacts collection
    match /contacts/{contactId} {
      // Users can only read their own contacts
      allow read: if isAuthenticated() && isOwner(resource.data.userId);

      // Users can create contacts with their own userId
      allow create: if isAuthenticated()
                    && isOwner(request.resource.data.userId)
                    && hasRequiredFields(['userId', 'name', 'createdAt']);

      // Users can update their own contacts
      allow update: if isAuthenticated() && isOwner(resource.data.userId);

      // Users can delete their own contacts
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Transactions collection
    match /transactions/{transactionId} {
      // Users can only read their own transactions
      allow read: if isAuthenticated() && isOwner(resource.data.userId);

      // Users can create transactions with their own userId
      allow create: if isAuthenticated()
                    && isOwner(request.resource.data.userId)
                    && hasRequiredFields(['userId', 'contactId', 'amount', 'description', 'date', 'category']);

      // Users can update their own transactions
      allow update: if isAuthenticated() && isOwner(resource.data.userId);

      // Users can delete their own transactions
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Savings Categories collection
    match /savingsCategories/{categoryId} {
      // Users can only read their own categories
      allow read: if isAuthenticated() && isOwner(resource.data.userId);

      // Users can create categories with their own userId
      allow create: if isAuthenticated()
                    && isOwner(request.resource.data.userId)
                    && hasRequiredFields(['userId', 'name', 'createdAt']);

      // Users can update their own categories
      allow update: if isAuthenticated() && isOwner(resource.data.userId);

      // Users can delete their own categories
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Savings Operations collection
    match /savingsOperations/{operationId} {
      // Users can only read their own operations
      allow read: if isAuthenticated() && isOwner(resource.data.userId);

      // Users can create operations with their own userId
      allow create: if isAuthenticated()
                    && isOwner(request.resource.data.userId)
                    && hasRequiredFields(['userId', 'categoryId', 'type', 'amount', 'date', 'description']);

      // Users can update their own operations
      allow update: if isAuthenticated() && isOwner(resource.data.userId);

      // Users can delete their own operations
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
