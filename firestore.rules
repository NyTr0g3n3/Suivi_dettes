rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document (with fallback)
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Contacts collection
    match /contacts/{contactId} {
      // Allow read if authenticated (relaxed rule to access old data)
      allow read: if isAuthenticated();

      // Users can create contacts with their own userId
      allow create: if isAuthenticated()
                    && isOwner(request.resource.data.userId);

      // Users can update their own contacts
      allow update: if isAuthenticated()
                    && (!exists(/databases/$(database)/documents/contacts/$(contactId))
                        || isOwner(resource.data.userId)
                        || !('userId' in resource.data));

      // Users can delete their own contacts
      allow delete: if isAuthenticated()
                    && (!exists(/databases/$(database)/documents/contacts/$(contactId))
                        || isOwner(resource.data.userId)
                        || !('userId' in resource.data));
    }

    // Transactions collection
    match /transactions/{transactionId} {
      // Allow read if authenticated (relaxed rule to access old data)
      allow read: if isAuthenticated();

      // Users can create transactions with their own userId
      allow create: if isAuthenticated()
                    && isOwner(request.resource.data.userId);

      // Users can update their own transactions
      allow update: if isAuthenticated()
                    && (!exists(/databases/$(database)/documents/transactions/$(transactionId))
                        || isOwner(resource.data.userId)
                        || !('userId' in resource.data));

      // Users can delete their own transactions
      allow delete: if isAuthenticated()
                    && (!exists(/databases/$(database)/documents/transactions/$(transactionId))
                        || isOwner(resource.data.userId)
                        || !('userId' in resource.data));
    }

    // Savings Categories collection
    match /savingsCategories/{categoryId} {
      // Allow read if authenticated (relaxed rule to access old data)
      allow read: if isAuthenticated();

      // Users can create categories with their own userId
      allow create: if isAuthenticated()
                    && isOwner(request.resource.data.userId);

      // Users can update their own categories
      allow update: if isAuthenticated()
                    && (!exists(/databases/$(database)/documents/savingsCategories/$(categoryId))
                        || isOwner(resource.data.userId)
                        || !('userId' in resource.data));

      // Users can delete their own categories
      allow delete: if isAuthenticated()
                    && (!exists(/databases/$(database)/documents/savingsCategories/$(categoryId))
                        || isOwner(resource.data.userId)
                        || !('userId' in resource.data));
    }

    // Savings Operations collection
    match /savingsOperations/{operationId} {
      // Allow read if authenticated (relaxed rule to access old data)
      allow read: if isAuthenticated();

      // Users can create operations with their own userId
      allow create: if isAuthenticated()
                    && isOwner(request.resource.data.userId);

      // Users can update their own operations
      allow update: if isAuthenticated()
                    && (!exists(/databases/$(database)/documents/savingsOperations/$(operationId))
                        || isOwner(resource.data.userId)
                        || !('userId' in resource.data));

      // Users can delete their own operations
      allow delete: if isAuthenticated()
                    && (!exists(/databases/$(database)/documents/savingsOperations/$(operationId))
                        || isOwner(resource.data.userId)
                        || !('userId' in resource.data));
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
